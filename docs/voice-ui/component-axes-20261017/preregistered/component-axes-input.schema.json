{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-ui.component-axes-input/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "axis",
    "oracle_sha256",
    "fixture_contract",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "voice-ui.component-axes-input/1"
    },
    "axis": {
      "enum": [
        "G",
        "R",
        "F",
        "E"
      ]
    },
    "oracle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_contract": {
      "$ref": "#/$defs/fixture"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "axis": {
            "const": "R"
          }
        }
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/$defs/readyCase"
            }
          }
        }
      },
      "else": {
        "properties": {
          "cases": {
            "items": {
              "not": {
                "required": [
                  "parts"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_id",
        "base_records",
        "base_pins",
        "fixtures",
        "recent_conversation",
        "scope"
      ],
      "properties": {
        "map_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "base_records": {
          "type": "array"
        },
        "base_pins": {
          "type": "array"
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "extra_records",
              "extra_pins"
            ],
            "properties": {
              "extra_records": {
                "type": "array"
              },
              "extra_pins": {
                "type": "array"
              }
            }
          }
        },
        "recent_conversation": {
          "type": "array"
        },
        "scope": {
          "type": "null"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "purpose",
        "label",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "not": {
            "const": "none"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "step",
            "decision",
            "data",
            "start",
            "end",
            "group"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixture",
        "utterance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "utterance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "parts": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      }
    },
    "readyCase": {
      "allOf": [
        {
          "$ref": "#/$defs/case"
        },
        {
          "required": [
            "parts"
          ]
        }
      ]
    }
  }
}
