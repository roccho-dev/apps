      "expected_gate":"sufficient","expected_missing":[],
      "expected_added_regions":[{"label":"API","kind":"step","parent":"fixture:container"}],"expected_added_edges":[]
    },
    {
      "id":"H02","fixture":"empty","utterance":"OCIに判断の部品を1個だけ置いて。",
      "expected_gate":"sufficient","expected_missing":[],
      "expected_added_regions":[{"label":"判断","kind":"decision","parent":"fixture:container"}],"expected_added_edges":[]
    },
    {
      "id":"H03","fixture":"api","utterance":"OCIの中にDBをひとつ新しく作り、既存のAPIからそのDBへ矢印を1本つないで。",
      "expected_gate":"sufficient","expected_missing":[],
      "expected_added_regions":[{"label":"DB","kind":"data","parent":"fixture:container"}],
      "expected_added_edges":[{"from":"fixture:initial-api","to":"added:DB","kind":"flow","label":""}]
    },
    {
      "id":"H04","fixture":"pair","utterance":"今あるDBから今あるAPIへ矢印を1本だけ追加して。新しい部品は不要。",
      "expected_gate":"sufficient","expected_missing":[],"expected_added_regions":[],
      "expected_added_edges":[{"from":"fixture:initial-db","to":"fixture:initial-api","kind":"flow","label":""}]
    },
    {
      "id":"H05","fixture":"empty","utterance":"OCIの中に「整形受付」という名前の工程をひとつだけ作って。",
      "expected_gate":"missing",
      "expected_missing":[{"label":"整形受付","kind":"step","occurrence":1}],
      "expected_added_regions":[{"label":"整形受付","kind":"step","parent":"fixture:container"}],"expected_added_edges":[]
    },
    {
      "id":"H06","fixture":"empty","utterance":"OCIの中に「読込班」「点検班」「保管班」という3つのグループを、同じ階層に1つずつ追加して。",
      "expected_gate":"missing",
      "expected_missing":[{"label":"読込班","kind":"group","occurrence":1},{"label":"点検班","kind":"group","occurrence":1},{"label":"保管班","kind":"group","occurrence":1}],
      "expected_added_regions":[{"label":"読込班","kind":"group","parent":"fixture:container"},{"label":"点検班","kind":"group","parent":"fixture:container"},{"label":"保管班","kind":"group","parent":"fixture:container"}],"expected_added_edges":[]
    },
    {
      "id":"H07","fixture":"empty","utterance":"OCIにDBを3つ追加して。表示名は3つともDBで、矢印はいらない。",
      "expected_gate":"missing",
      "expected_missing":[{"label":"DB","kind":"data","occurrence":1},{"label":"DB","kind":"data","occurrence":2}],
      "expected_added_regions":[{"label":"DB","kind":"data","parent":"fixture:container"},{"label":"DB","kind":"data","parent":"fixture:container"},{"label":"DB","kind":"data","parent":"fixture:container"}],"expected_added_edges":[]
    },
    {
      "id":"H08","fixture":"empty","utterance":"OCIに「検品室」というグループを作り、その中に「寸法測定」という工程と「測定票」というデータを置いて。寸法測定から測定票へ矢印を1本つないで。",
      "expected_gate":"missing",
      "expected_missing":[{"label":"検品室","kind":"group","occurrence":1},{"label":"寸法測定","kind":"step","occurrence":1},{"label":"測定票","kind":"data","occurrence":1}],
      "expected_added_regions":[{"label":"検品室","kind":"group","parent":"fixture:container"},{"label":"寸法測定","kind":"step","parent":"added:検品室"},{"label":"測定票","kind":"data","parent":"added:検品室"}],
      "expected_added_edges":[{"from":"added:寸法測定","to":"added:測定票","kind":"flow","label":""}]
    },
    {
      "id":"H09","fixture":"empty","utterance":"OCIにあれを追加して。",
      "expected_gate":"ambiguous","expected_missing":[],"expected_added_regions":[],"expected_added_edges":[]
    },
    {
      "id":"H10","fixture":"pair","utterance":"追加も接続もしないで。今の図をそのままにしておいて。",
      "expected_gate":"no-change","expected_missing":[],"expected_added_regions":[],"expected_added_edges":[]
    }
  ]
}
